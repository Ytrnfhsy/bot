# Пресет агента під Qwen3.6-35B-A3B (deploy/qwen36/docker-compose.yml, 127.0.0.1:8085).
# Перемикання моделей: deploy/switch-model.sh qwen | bonsai

BONSAI_BACKEND=openai
BONSAI_LLM_URL=http://127.0.0.1:8085
# має збігатися з --alias у deploy/qwen36/docker-compose.yml
BONSAI_MODEL=qwen3.6-35b-a3b
BONSAI_TOOL_MODE=auto
# порожньо — діють --temp/--top-p/--top-k з compose
BONSAI_TEMPERATURE=
# з увімкненими міркуваннями відповідь може йти довше
BONSAI_REQUEST_TIMEOUT=1200

# Контекст -c 65536 токенів (один слот). ~120k символів історії + промпт і результати інструментів.
BONSAI_MAX_HISTORY_CHARS=120000
BONSAI_MAX_TOOL_OUTPUT_CHARS=20000
BONSAI_MAX_STEPS=30

BONSAI_LANGUAGE=українська
BONSAI_AGENT_NAME=Kru
BONSAI_PERSONA=
BONSAI_WORKSPACE=~/bonsai-workspace
BONSAI_ALLOW_OUTSIDE_WORKSPACE=false
BONSAI_AUTO_APPROVE=false
BONSAI_SHELL_TIMEOUT=120
BONSAI_PYTHON_TIMEOUT=120
BONSAI_SEARXNG_URL=

BONSAI_HOST=0.0.0.0
BONSAI_PORT=8765
BONSAI_TOKEN=
