# Скопіюй у .env (у директорії, звідки запускаєш `bonsai`) або в /etc/bonsai-agent.env для systemd.

# --- LLM-бекенд ---
# ollama (типово) | openai — OpenAI-сумісний сервер, напр. llama-server з форку PrismML llama.cpp
# (використовуй його, якщо твоя версія Ollama не завантажує ternary GGUF)
BONSAI_BACKEND=ollama
BONSAI_LLM_URL=http://127.0.0.1:8080
BONSAI_API_KEY=

# --- Ollama ---
BONSAI_OLLAMA_URL=http://127.0.0.1:11434
# Ternary Bonsai 2 27B з Hugging Face (можна вказати конкретний квант після двокрапки)
BONSAI_MODEL=hf.co/prism-ml/Ternary-Bonsai-27B-gguf
# auto | native | json — як модель викликає інструменти
BONSAI_TOOL_MODE=auto
# auto (не передавати) | true | false — режим «міркувань» моделі
BONSAI_THINK=auto
BONSAI_NUM_CTX=16384
BONSAI_TEMPERATURE=0.6
BONSAI_KEEP_ALIVE=30m

# --- Агент ---
BONSAI_MAX_STEPS=25
# Розуміння зображень: auto | on | off (потрібна модель із зором, напр. Qwen3.6 + mmproj)
BONSAI_VISION=auto
BONSAI_LANGUAGE=українська
# Ім'я агента та (необов'язково) його характер
BONSAI_AGENT_NAME=Kru
BONSAI_PERSONA=
BONSAI_WORKSPACE=~/bonsai-workspace
BONSAI_ALLOW_OUTSIDE_WORKSPACE=false
# true — виконувати shell/python/запис файлів без підтвердження (небезпечно!)
BONSAI_AUTO_APPROVE=false
BONSAI_SHELL_TIMEOUT=120
BONSAI_PYTHON_TIMEOUT=120
# Необов'язково: власний SearXNG для пошуку (інакше DuckDuckGo)
BONSAI_SEARXNG_URL=

# --- Сервер ---
BONSAI_HOST=0.0.0.0
BONSAI_PORT=8765
# ОБОВ'ЯЗКОВО задай довгий випадковий токен: openssl rand -hex 24
BONSAI_TOKEN=
