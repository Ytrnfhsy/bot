# Налаштування агента Kru. Інсталятор копіює цей файл у ~/.config/kru.env
# (для запуску вручну — у .env поруч, звідки запускаєш `kru`).

# --- Модель: Qwen3.6-35B-A3B у llama-server (deploy/qwen36/docker-compose.yml) ---
KRU_BACKEND=openai
KRU_LLM_URL=http://127.0.0.1:8085
KRU_API_KEY=
# має збігатися з --alias у docker-compose.yml
KRU_MODEL=qwen3.6-35b-a3b
# auto | native | json — як модель викликає інструменти
KRU_TOOL_MODE=auto
# порожньо — діють --temp/--top-p/--top-k з compose
KRU_TEMPERATURE=
# з увімкненими міркуваннями відповідь може йти довше
KRU_REQUEST_TIMEOUT=1200

# Контекст -c 65536 токенів (один слот): ~120k символів історії + промпт і результати інструментів
KRU_MAX_HISTORY_CHARS=120000
KRU_MAX_TOOL_OUTPUT_CHARS=20000
KRU_MAX_STEPS=30
# Зір: auto — увімкнено, якщо llama-server запущено з mmproj (інакше вимкнеться сам); on | off
KRU_VISION=auto

# --- Агент ---
KRU_LANGUAGE=українська
# Часовий пояс користувачів за замовчуванням (IANA). Робот передає пояс свого ПК сам — це лише запасний варіант
# (CLI, API). Порожньо — пояс сервера.
KRU_TIMEZONE=
# Ім'я агента та (необов'язково) його характер
KRU_AGENT_NAME=Kru
KRU_PERSONA=
KRU_WORKSPACE=~/kru-workspace
KRU_ALLOW_OUTSIDE_WORKSPACE=false
# Робочі теки інших користувачів (kru user add …): <USERS_WORKSPACE>/<ім'я>/
KRU_USERS_WORKSPACE=~/kru-users
# true — виконувати shell/python/запис файлів без підтвердження (небезпечно!)
KRU_AUTO_APPROVE=false
# Пісочниця для shell/Python: off — на сервері (з підтвердженням); docker — в одноразовому контейнері, що бачить
# лише робочу теку (без запитів дозволу; і звичайні користувачі). Увімкнути: deploy/sandbox.sh build
KRU_SANDBOX=off
# none — без інтернету в пісочниці; ліміти; true — питати дозволу навіть у пісочниці
KRU_SANDBOX_NETWORK=bridge
KRU_SANDBOX_MEMORY=2g
KRU_SANDBOX_CPUS=2
KRU_SANDBOX_CONFIRM=false
KRU_SHELL_TIMEOUT=120
KRU_PYTHON_TIMEOUT=120
# Власний SearXNG для пошуку (deploy/searxng.sh start пропише сам; порожньо — DuckDuckGo)
KRU_SEARXNG_URL=

# --- Зображення ---
# Скільки пікселів лишати перед моделлю: звичайний перегляд і «детальний» (дрібний текст). Менше — швидше
# й менше VRAM, більше — видно дрібніші деталі (~1 токен на 28×28 пікселів)
KRU_IMAGE_MAX_PIXELS=1000000
KRU_IMAGE_MAX_PIXELS_HIGH=2500000

# --- Telegram ---
# Токен бота від @BotFather; потім на сервері: kru telegram link (і напиши боту)
KRU_TELEGRAM_BOT_TOKEN=
# true — сервер слухає бота: можна писати агенту з Telegram; false — бот лише надсилає повідомлення
KRU_TELEGRAM_POLL=true

# --- Голос ---
# Розпізнавання: deploy/voice.sh install. Озвучення: deploy/holos.sh start (HolosTTS, ставить KRU_TTS_URL);
# без HolosTTS — Piper (теж deploy/voice.sh install).
# auto — увімкнено, якщо встановлено; off — вимкнено
KRU_VOICE=auto
# Модель розпізнавання: turbo (типово), small (легша), medium, large-v3
KRU_WHISPER_MODEL=turbo
KRU_WHISPER_LANGUAGE=uk
KRU_WHISPER_DEVICE=cpu
# 1 — найшвидше (типово), 5 — трохи точніше; потоки CPU (0 — половина логічних ядер)
KRU_WHISPER_BEAM=1
KRU_WHISPER_THREADS=0
# HolosTTS: адреса сервісу (порожньо — Piper) і голос за замовчуванням (напр. «Гаська Шиян»; порожньо — Speaker_67)
KRU_TTS_URL=
KRU_TTS_VOICE=
# Запасний Piper: порожньо — <DATA_DIR>/voice/uk_UA-ukrainian_tts-medium.onnx; диктор 0 Лада, 1 Микита, 2 Тетяна
KRU_PIPER_VOICE=
KRU_PIPER_SPEAKER=0
# Обробка голосу за замовчуванням: natural | robot | digital | droid | mech (у роботі можна вибрати свою)
KRU_VOICE_EFFECT=natural

# SSH до віддалених машин налаштовується командою `kru ssh add …` (список — <DATA_DIR>/ssh/hosts.json)

# --- Пам'ять ---
# Пошук пам'яті за змістом: модель ембедингів (deploy/model.sh start запускає її на :8086).
# Порожньо — шукати лише за словами.
KRU_EMBED_URL=http://127.0.0.1:8086
KRU_EMBED_MODEL=qwen3-embedding-0.6b
# Наскільки схожим (0…1) має бути запис, щоб агент вважав його доречним
KRU_MEMORY_MIN_SCORE=0.45
# Довгі розмови: старі повідомлення стискаються в підсумок, а не відкидаються
KRU_SUMMARIZE=true

# --- Сервер ---
KRU_HOST=0.0.0.0
KRU_PORT=8765
# ОБОВ'ЯЗКОВО задай довгий випадковий токен: openssl rand -hex 24 (інсталятор робить це сам)
KRU_TOKEN=
