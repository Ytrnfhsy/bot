# Пресет під docker compose з llama-server (форк PrismML) на 127.0.0.1:8085, alias bonsai-2-27b.
# Решта параметрів і їхній опис — у .env.example.

BONSAI_BACKEND=openai
BONSAI_LLM_URL=http://127.0.0.1:8085
# має збігатися з --alias у compose
BONSAI_MODEL=bonsai-2-27b
# llama-server з --jinja розбирає tool calls сам
BONSAI_TOOL_MODE=auto
# порожньо — діють --temp/--top-p/--top-k з compose
BONSAI_TEMPERATURE=
BONSAI_REQUEST_TIMEOUT=900

# Розмір історії має відповідати контексту ОДНОГО слота llama-server: -c / -np.
# (без -np 1 llama-server ділить -c між кількома слотами, напр. 81920/4 = 20480 токенів на запит!)
# Значення нижче — для -c 81920 -np 1; для -c 32768 -np 1 постав ~60000.
# Контекст у compose: -c 81920 токенів. Кирилиця ≈ 2.5–3 символи на токен,
# тож ~150k символів історії + системний промпт і результати інструментів вміщаються із запасом.
BONSAI_MAX_HISTORY_CHARS=150000
BONSAI_MAX_TOOL_OUTPUT_CHARS=20000
BONSAI_MAX_STEPS=30

BONSAI_LANGUAGE=українська
BONSAI_WORKSPACE=~/bonsai-workspace
BONSAI_ALLOW_OUTSIDE_WORKSPACE=false
BONSAI_AUTO_APPROVE=false
BONSAI_SHELL_TIMEOUT=120
BONSAI_PYTHON_TIMEOUT=120
BONSAI_SEARXNG_URL=

BONSAI_HOST=0.0.0.0
BONSAI_PORT=8765
BONSAI_TOKEN=
